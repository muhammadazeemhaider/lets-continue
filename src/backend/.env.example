# Copy to .env and fill in a Google AI Studio API key. Do not commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_WARM_PER_PASS=3

# Database. Leave empty for a local SQLite file (data/toward_the_light.db).
# For Tiger Data (hosted Postgres) paste the service URL from console.cloud.timescale.com:
DATABASE_URL=
# Accounts: every reader signs up (name, what to call them, optional email). 0 = single-user local mode.
AUTH_REQUIRED=1
